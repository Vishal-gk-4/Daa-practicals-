
#include <iostream>
using namespace std;

int main()
{
    int n = 4;

    int cost[4][4] = {
        {0, 10, 15, 20},
        {10, 0, 35, 25},
        {15, 35, 0, 30},
        {20, 25, 30, 0}
    };

    int visited[4] = {0};
    int minCost = 9999;

    visited[0] = 1;

    // Try all possible paths
    for (int a = 1; a < n; a++)
    {
        for (int b = 1; b < n; b++)
        {
            for (int c = 1; c < n; c++)
            {
                if (a != b && b != c && a != c)
                {
                    int total = cost[0][a]
                              + cost[a][b]
                              + cost[b][c]
                              + cost[c][0];

                    if (total < minCost)
                    {
                        minCost = total;
                    }
                }
            }
        }
    }

    cout << "Minimum travelling cost = " << minCost;

    return 0;
}


time complexity : big o (n!)
