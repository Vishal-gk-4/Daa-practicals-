
#include <iostream>
#include <algorithm>
using namespace std;

int main()
{
    int coins[] = {1, 4, 6};
    int n = 3;
    int amount = 9;

    int dp[100];

    dp[0] = 0;

    for(int i = 1; i <= amount; i++)
    {
        dp[i] = 9999;
    }

    for(int i = 1; i <= amount; i++)
    {
        for(int j = 0; j < n; j++)
        {
            if(coins[j] <= i)
            {
                dp[i] = min(dp[i],
                            1 + dp[i - coins[j]]);
            }
        }
    }

    cout << "Minimum coins required: "
         << dp[amount];

    return 0;
}
