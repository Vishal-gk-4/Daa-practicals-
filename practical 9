
#include <iostream>
using namespace std;

int main()
{
    int n;
    cout << "Enter number of vertices: ";
    cin >> n;

    int cost[10][10];

    cout << "Enter cost matrix:\n";

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cin >> cost[i][j];
        }
    }

    int visited[10] = {0};
    visited[0] = 1;

    int edges = 0;
    int totalCost = 0;

    cout << "\nMinimum Spanning Tree:\n";

    while (edges < n - 1)
    {
        int min = 999;
        int a = -1, b = -1;

        for (int i = 0; i < n; i++)
        {
            if (visited[i])
            {
                for (int j = 0; j < n; j++)
                {
                    if (!visited[j] && cost[i][j] != 0 &&
                        cost[i][j] < min)
                    {
                        min = cost[i][j];
                        a = i;
                        b = j;
                    }
                }
            }
        }

        if (a == -1)
        {
            cout << "Graph is disconnected!";
            return 0;
        }

        cout << a << " - " << b
             << " : " << min << endl;

        totalCost += min;
        visited[b] = 1;
        edges++;
    }

    cout << "\nTotal Minimum Cost = " << totalCost;

    return 0;
} 
time complexity : big ( v ^2) v = number edges 
