
#include <iostream>
#include <vector>
using namespace std;

vector<int> adj[100];
bool visited[100] = {false};

void DFS(int node)
{
    visited[node] = true;
    cout << node << " ";

    for (int neighbour : adj[node])
    {
        if (!visited[neighbour])
        {
            DFS(neighbour);
        }
    }
}

int main()
{
    int n, e;

    cout << "Enter vertices: ";
    cin >> n;

    cout << "Enter edges: ";
    cin >> e;

    cout << "Enter edges:\n";

    for (int i = 0; i < e; i++)
    {
        int u, v;
        cin >> u >> v;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "DFS Traversal: ";
    DFS(0);

    return 0;
}
