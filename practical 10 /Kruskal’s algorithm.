
#include <iostream>
#include <algorithm>
using namespace std;

struct Edge
{
    int u, v, weight;
};

int parent[100];

int find(int x)
{
    if (parent[x] == x)
        return x;

    return parent[x] = find(parent[x]);
}

void unionSet(int u, int v)
{
    int a = find(u);
    int b = find(v);

    parent[a] = b;
}

int main()
{
    int n, e;

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> e;

    Edge edges[100];

    cout << "Enter edges (u v weight):\n";

    for (int i = 0; i < e; i++)
    {
        cin >> edges[i].u
            >> edges[i].v
            >> edges[i].weight;
    }

    // Sort edges by weight
    sort(edges, edges + e,
         [](Edge a, Edge b)
         {
             return a.weight < b.weight;
         });

    // Initialize parent array
    for (int i = 0; i < n; i++)
    {
        parent[i] = i;
    }

    int totalCost = 0;
    int count = 0;

    cout << "\nMinimum Spanning Tree:\n";

    for (int i = 0; i < e && count < n - 1; i++)
    {
        int u = edges[i].u;
        int v = edges[i].v;

        if (find(u) != find(v))
        {
            cout << u << " - " << v
                 << " : " << edges[i].weight << endl;

            totalCost += edges[i].weight;

            unionSet(u, v);
            count++;
        }
    }

    if (count != n - 1)
    {
        cout << "Graph is disconnected!";
    }
    else
    {
        cout << "\nTotal Minimum Cost = " << totalCost;
    }

    return 0;
}
time complixity : O(E log E) 
e = number of the edges of the graph 
log E = Number of times we can divide E by 2 until we reach 1 (approximately).
